<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_business_requirement_form" model="ir.ui.view">
        <field name="name">business.requirement.form</field>
        <field name="model">business.requirement</field>
        <field
            name="inherit_id"
            ref="business_requirement.view_business_requirement_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="can_generate_tasks" invisible="1" />
                <button
                    name="action_generate_tasks"
                    string="Create Tasks"
                    type="object"
                    class="oe_highlight"
                    invisible="not can_generate_tasks"
                    groups="project.group_project_user"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_tasks"
                    icon="fa-tasks"
                    groups="project.group_project_user"
                >
                    <field name="task_count" string="Tasks" widget="statinfo" />
                </button>
            </xpath>
            <xpath expr="//group/field[@name='origin']" position="after">
                <field
                    name="task_generation"
                    readonly="state not in ['draft', 'confirmed']"
                    groups="project.group_project_user"
                />
                <field
                    name="project_id"
                    invisible="task_generation == 'none' or (task_generation == 'project' and not project_id)"
                    readonly="state not in ['draft', 'confirmed'] or task_generation == 'project'"
                    required="task_generation == 'task'"
                    groups="project.group_project_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
